<Application x:Class="ItzyLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ItzyLauncher.Views.Pages"
             xmlns:pageVm="clr-namespace:ItzyLauncher.ViewModels.Pages"
             xmlns:helpers="clr-namespace:ItzyLauncher.Helpers">

    <Application.Resources>

        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <helpers:ServerStatusColorConverter x:Key="ServerStatusColorConverter"/>
        <helpers:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <helpers:GraphicsQualityConverter x:Key="GraphicsQualityConverter"/>
        <helpers:ProgressConverter x:Key="ProgressConverter"/>

        <DataTemplate DataType="{x:Type pageVm:HomePageViewModel}">
            <pages:HomePageView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type pageVm:AccountPageViewModel}">
            <pages:AccountPageView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type pageVm:SettingsPageViewModel}">
            <pages:SettingsPageView />
        </DataTemplate>

    </Application.Resources>
</Application>