<Window x:Class="ItzyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Itzy Launcher"
        Width="1440"
        Height="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="28"
            Background="#0B0D14"
            BorderBrush="#24283A"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="96"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BACKGROUND GLOW -->
            <Ellipse Width="520"
                     Height="520"
                     Fill="#33205F"
                     Opacity="0.55"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-180,-140,0"/>

            <Ellipse Width="420"
                     Height="420"
                     Fill="#123B5F"
                     Opacity="0.35"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-180,0,0,-160"/>

            <!-- TOP BAR -->
            <Grid Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Background="#111420"
                  MouseLeftButtonDown="TopBar_MouseLeftButtonDown">

                <TextBlock Text="{Binding LauncherTitle}"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="32,0,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">

                    <Button Content="Website"
                            Width="96"
                            Height="36"
                            Background="#1A1E2D"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,10,0"/>

                    <Button Content="Discord"
                            Width="96"
                            Height="36"
                            Background="#1A1E2D"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,18,0"/>

                    <Button Content="—"
                            Width="42"
                            Height="36"
                            Background="#1A1E2D"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Minimize_Click"/>

                    <Button Content="X"
                            Width="42"
                            Height="36"
                            Background="#8B2E3C"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="8,0,0,0"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- SIDEBAR -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    Background="#0F121D"
                    Padding="24">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Border Width="72"
                                Height="72"
                                CornerRadius="22"
                                Background="#191D2C"
                                HorizontalAlignment="Left">

                            <TextBlock Text="I"
                                       Foreground="#9B6CFF"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="ItzyMU"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,14,0,0"/>

                        <TextBlock Text="Season XIII"
                                   Foreground="#8D93A8"
                                   FontSize="13"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding MenuItems}"
                                  Margin="0,18,0,0">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding Command}"
                                        Height="54"
                                        Margin="0,0,0,12"
                                        Background="#171B29"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="16"
                                        Cursor="Hand">

                                    <Grid>
                                        <TextBlock Text="{Binding Text}"
                                                   VerticalAlignment="Center"
                                                   Margin="22,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2"
                            CornerRadius="20"
                            Background="#171B29"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Server"
                                       Foreground="#8D93A8"
                                       FontSize="13"/>

                            <TextBlock Text="ONLINE"
                                       Foreground="#45FF9A"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                            <TextBlock Text="Players: 0"
                                       Foreground="#8D93A8"
                                       FontSize="13"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="1"
                  Grid.Column="1"
                  Margin="28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HERO NEWS -->
                <Border Grid.Row="0"
                        CornerRadius="30"
                        Background="#171B29"
                        Padding="34">

                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SEASON XIII"
                                       Foreground="#9B6CFF"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="The Adventure Begins"
                                       Foreground="White"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="News, events, updates and server announcements will appear here."
                                       Foreground="#A8ADBD"
                                       FontSize="16"
                                       Width="560"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PAGE CONTENT -->
                <Border Grid.Row="1"
                        CornerRadius="30"
                        Background="#131725"
                        Padding="28"
                        Margin="0,24,0,0">

                    <ContentControl Content="{Binding CurrentPage}" />
                </Border>
            </Grid>

            <!-- BOTTOM PLAY BAR -->
            <Border Grid.Row="2"
                    Grid.Column="1"
                    Background="#111420"
                    Padding="28,16">

                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClientVersion, StringFormat=Client version: {0}}"
                                   Foreground="#8D93A8"
                                   FontSize="13"/>

                        <Border Width="520"
                                Height="10"
                                CornerRadius="5"
                                Background="#222638"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left">

                            <Border Width="260"
                                    CornerRadius="5"
                                    Background="#9B6CFF"
                                    HorizontalAlignment="Left"/>
                        </Border>
                    </StackPanel>

                    <Button Content="▶ PLAY NOW"
                            Width="300"
                            Height="64"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#8B5CF6"
                            Foreground="White"
                            FontSize="24"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>