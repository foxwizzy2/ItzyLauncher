<UserControl x:Class="ItzyLauncher.Views.Pages.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#11141F" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Settings"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"/>
            
            <TextBlock Text="Customize your launcher and game experience"
                       Foreground="#8D93A8"
                       FontSize="14"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- SETTINGS CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LAUNCHER SETTINGS -->
                <Border Grid.Column="0"
                        CornerRadius="20"
                        Background="#171B29"
                        BorderBrush="#24283A"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Launcher Settings"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,16"/>

                        <!-- AUTO LAUNCH -->
                        <Border CornerRadius="12" Background="#0F121D" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto Launch Game"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Automatically launch game on startup"
                                               Foreground="#8D93A8"
                                               FontSize="12"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding AutoLaunch}"
                                          Width="20"
                                          Height="20"/>
                            </Grid>
                        </Border>

                        <!-- KEEP LAUNCHER OPEN -->
                        <Border CornerRadius="12" Background="#0F121D" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Keep Launcher Open"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Keep launcher running while playing"
                                               Foreground="#8D93A8"
                                               FontSize="12"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding KeepLauncherOpen}"
                                          Width="20"
                                          Height="20"/>
                            </Grid>
                        </Border>

                        <!-- ENABLE SOUNDS -->
                        <Border CornerRadius="12" Background="#0F121D" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Enable Sounds"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Play launcher notification sounds"
                                               Foreground="#8D93A8"
                                               FontSize="12"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding EnableSounds}"
                                          Width="20"
                                          Height="20"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- GAME SETTINGS -->
                <Border Grid.Column="1"
                        CornerRadius="20"
                        Background="#171B29"
                        BorderBrush="#24283A"
                        BorderThickness="1"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Game Settings"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,16"/>

                        <!-- GRAPHICS QUALITY -->
                        <Border CornerRadius="12" Background="#0F121D" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Graphics Quality"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>

                                <Slider Minimum="0" Maximum="3" Value="{Binding GraphicsQuality}" 
                                        Height="6"
                                        Background="#1A1E2D" Foreground="#8B5CF6"/>

                                <TextBlock Text="{Binding GraphicsQuality, Converter={StaticResource GraphicsQualityConverter}}"
                                           Foreground="#8D93A8"
                                           FontSize="12"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- GAME DIRECTORY -->
                        <Border CornerRadius="12" Background="#0F121D" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Game Directory"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>

                                <Border CornerRadius="8" Background="#0B0D14" BorderBrush="#24283A" BorderThickness="1" Padding="8" Height="32" Margin="0,0,0,8">
                                    <TextBox Background="Transparent"
                                             Foreground="White"
                                             BorderThickness="0"
                                             IsReadOnly="True"
                                             Text="{Binding GameDirectory}"/>
                                </Border>

                                <Border CornerRadius="8" Background="#8B5CF6" Height="36">
                                    <Button Background="Transparent"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Content="BROWSE"
                                            Cursor="Hand"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>
