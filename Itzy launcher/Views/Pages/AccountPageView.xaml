<UserControl x:Class="ItzyLauncher.Views.Pages.AccountPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#11141F" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Account Panel"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"/>
            
            <TextBlock Text="View your characters, stats, and account settings"
                       Foreground="#8D93A8"
                       FontSize="14"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- CHARACTERS LIST -->
                <Border Grid.Column="0"
                        CornerRadius="20"
                        Background="#171B29"
                        BorderBrush="#24283A"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Your Characters"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,16"/>

                        <Border CornerRadius="12"
                                Background="#0F121D"
                                BorderBrush="#24283A"
                                BorderThickness="1"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- CHARACTER PORTRAIT -->
                                <Border Grid.Column="0"
                                        CornerRadius="12"
                                        Background="#1A1E2D"
                                        Height="80"
                                        Width="80">
                                    <TextBlock Text="🗡️"
                                               FontSize="40"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- CHARACTER INFO -->
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Dark Knight"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"/>
                                    
                                    <TextBlock Text="Level 400"
                                               Foreground="#8B5CF6"
                                               FontSize="14"
                                               Margin="0,4,0,0"/>

                                    <TextBlock Text="Experience: 99.5%"
                                               Foreground="#8D93A8"
                                               FontSize="12"
                                               Margin="0,4,0,0"/>

                                    <Border Background="#0B0D14" CornerRadius="3" Height="6" Margin="0,8,100,0">
                                        <Border Background="#8B5CF6" CornerRadius="3"/>
                                    </Border>
                                </StackPanel>

                                <!-- SELECT BUTTON -->
                                <Border Grid.Column="2" CornerRadius="8" Background="#8B5CF6" Height="36" Width="100" VerticalAlignment="Center">
                                    <Button Height="36"
                                            Width="100"
                                            Background="Transparent"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Content="SELECT"
                                            Cursor="Hand"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="You have 1 character slot available"
                                   Foreground="#8D93A8"
                                   FontSize="12"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ACCOUNT STATS -->
                <Border Grid.Column="1"
                        CornerRadius="20"
                        Background="#171B29"
                        BorderBrush="#24283A"
                        BorderThickness="1"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Account Stats"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,16"/>

                        <!-- STAT ITEM -->
                        <Border CornerRadius="12" Background="#0F121D" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Playtime"
                                           Foreground="#8D93A8"
                                           FontSize="11"/>
                                <TextBlock Text="1,234h 56m"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" Background="#0F121D" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="VIP Status"
                                           Foreground="#8D93A8"
                                           FontSize="11"/>
                                <TextBlock Text="VIP Level 3"
                                           Foreground="#45FF9A"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" Background="#0F121D" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="W-Coins"
                                           Foreground="#8D93A8"
                                           FontSize="11"/>
                                <TextBlock Text="50,000"
                                           Foreground="#FFB84D"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" Background="#0F121D" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Reset Count"
                                           Foreground="#8D93A8"
                                           FontSize="11"/>
                                <TextBlock Text="12"
                                           Foreground="#FF6B6B"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" Background="#8B5CF6" Height="40" Margin="0,16,0,0">
                            <Button Background="Transparent"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Content="LOGOUT"
                                    Cursor="Hand"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>