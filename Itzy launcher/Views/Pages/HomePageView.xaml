<UserControl x:Class="ItzyLauncher.Views.Pages.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#11141F" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NEWS CAROUSEL SECTION -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Border CornerRadius="20" Background="#171B29" BorderBrush="#24283A" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- NEWS AREA -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                        <TextBlock Text="Welcome to MU Online" 
                                   Foreground="White" 
                                   FontSize="32" 
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        
                        <TextBlock Text="Join thousands of adventurers in the mystical world"
                                   Foreground="#8D93A8"
                                   FontSize="16"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>

                        <Border CornerRadius="12" Background="#8B5CF6" Width="200" Height="48" Margin="0,20,0,0">
                            <TextBlock Text="View Patch Notes"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Cursor="Hand"/>
                        </Border>
                    </StackPanel>

                    <!-- SERVER STATUS SECTION -->
                    <Border Grid.Column="1" 
                            CornerRadius="20,0,20,0"
                            Background="#0F121D"
                            BorderBrush="#24283A"
                            BorderThickness="1,0,0,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                            <TextBlock Text="Server Status"
                                       Foreground="#8D93A8"
                                       FontSize="13"
                                       FontWeight="Bold"/>

                            <Ellipse Width="12" Height="12" Fill="#45FF9A" Margin="0,8,0,0"/>

                            <TextBlock Text="{Binding ServerStatus}"
                                       Foreground="#45FF9A"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                            <TextBlock Text="{Binding PlayerCount}"
                                       Foreground="#8D93A8"
                                       FontSize="14"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- LAUNCH SECTION -->
        <Border Grid.Row="1" CornerRadius="20" Background="#171B29" BorderBrush="#24283A" BorderThickness="1" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SERVER SELECTOR -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Select Server"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12"
                                        Background="{Binding IsOnline, Converter={StaticResource ServerStatusColorConverter}}"
                                        BorderBrush="#8B5CF6"
                                        BorderThickness="0"
                                        Margin="0,0,12,0"
                                        Padding="12,8"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding Region}"
                                                   Foreground="#8D93A8"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"/>

                                        <TextBlock Text="{Binding OnlineCount, StringFormat='Players: {0}'}"
                                                   Foreground="#45FF9A"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- UPDATE PROGRESS -->
                <Border Grid.Row="1" 
                        CornerRadius="12" 
                        Background="#0F121D"
                        Visibility="{Binding ShowUpdateProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,16"
                        Padding="16">

                    <StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}"
                                   Foreground="#8D93A8"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>

                        <Border Background="#0B0D14" CornerRadius="4" Height="8">
                            <Border Background="#8B5CF6" 
                                    CornerRadius="4"
                                    Width="{Binding UpdateProgress, Converter={StaticResource ProgressConverter}}"
                                    HorizontalAlignment="Left"/>
                        </Border>

                        <TextBlock Text="{Binding UpdateProgress}" Foreground="#8D93A8"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- LAUNCH BUTTON -->
                <Border Grid.Row="2"
                        CornerRadius="12"
                        Background="#8B5CF6">
                    <Button Command="{Binding LaunchGameCommand}"
                            Height="56"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Content="{Binding LaunchButtonText}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>